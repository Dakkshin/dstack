# Copy to .env (setup.sh does this) and fill in. Never commit .env.
ELEVENLABS_API_KEY=
# Named voice: dax (default) or karpathy. The table lives in scripts/tts.py (VOICES);
# `tts.py --voices` prints it. A project can override this with VOICE_NAME in narration.py.
ELEVENLABS_VOICE=dax
# Raw id, used only when ELEVENLABS_VOICE is empty or narration.py sets VOICE_ID.
# ELEVENLABS_VOICE_ID=luatDliq6kNyK0iDnpTS
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# ELEVENLABS_SPEED=1.06
