# Copy to .env (setup.sh does this) and fill in. Never commit .env.
ELEVENLABS_API_KEY=
# The voice is chosen per project in narration.py (VOICE_NAME), never here.
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# ELEVENLABS_SPEED=1.06
# A writing style guide (JSON or Markdown) the agent reads before writing narration, and whose
# banned words the script lint checks. A project can override it with STYLE in narration.py.
# NARRATION_STYLE=/path/to/your/style-guide.json
